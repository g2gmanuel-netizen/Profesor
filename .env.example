# === LUCKY — configuración ===
# Copia este archivo a «.env» y rellena lo necesario.

# --- API de Claude (obligatorio) ---
ANTHROPIC_API_KEY=
# Si tu clave es de ámbito "Organización", pon aquí el id del espacio de
# trabajo (formato wrkspc_...). Se ve en console.anthropic.com > Espacios de
# trabajo. Alternativa recomendada: crear una clave DENTRO de un workspace.
ANTHROPIC_WORKSPACE_ID=
# Vacío = LUCKY elige el mejor modelo disponible automáticamente.
JARVIS_MODELO=

# --- Voz (salida) ---
# auto = ElevenLabs si hay clave, si no OpenAI, si no la voz del sistema.
JARVIS_TTS=auto
# Voz del sistema macOS (vacío = mejor voz española). Ej: Jorge, Mónica, Marisol.
JARVIS_VOZ=
JARVIS_VELOCIDAD=175
# Para voz humana (menos robótica):
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9
OPENAI_API_KEY=
OPENAI_VOICE=onyx

# --- Escucha (entrada) ---
# wake = requiere «lucky» o palmas para actuar; abierto = responde a cualquier voz.
JARVIS_MODO_ESCUCHA=abierto
JARVIS_ACTIVACION=lucky,oye lucky,hola lucky
JARVIS_ACTIVACION_EXTRA=
# Nº de golpes seguidos (palmas O chasquidos de dedos) para invocar a Lucky.
JARVIS_PALMAS=3
# tiny/base = menos lag; small/medium = más precisión (recomendado small).
JARVIS_WHISPER=small
# Idioma de la escucha: auto (detecta español/inglés), o fija es / en.
JARVIS_IDIOMA=auto

# --- Otros ---
JARVIS_CIUDAD=Madrid
JARVIS_DOCUMENTOS=~/Documents/LUCKY
JARVIS_PUERTO=8765
JARVIS_BUSQUEDA_WEB=0

# --- Alpaca (opcional, SOLO paper y lectura) ---
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE=https://paper-api.alpaca.markets
