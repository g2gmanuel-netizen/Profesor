# ============================================================
#  Bolsillo Diario — variables de entorno (plantilla)
#  Copia este archivo a ".env" y rellena los valores.
#  NUNCA subas el archivo .env al repositorio.
# ============================================================

# ---------- Identidad del medio ----------
NOMBRE_MEDIO="Bolsillo Diario"
DOMINIO="[PENDIENTE]"                 # ej. bolsillodiario.es (sin https://)
AUTOR_RESPONSABLE="[PENDIENTE]"       # tu nombre real
AUTOR_BIO="[PENDIENTE]"               # una línea de experiencia
EMAIL_CONTACTO="[PENDIENTE]"          # email público de contacto

# ---------- Anthropic (motor de agentes) ----------
# Clave de API. Sin ella, el pipeline solo funciona en modo simulación --sin-api.
ANTHROPIC_API_KEY=""
MODELO_REDACCION="claude-opus-4-8"   # potente (redactar/verificar). Alternativa más barata: claude-sonnet-5-5
MODELO_RAPIDO="claude-haiku-4-5"     # rápido/barato para clasificar y filtrar
PRESUPUESTO_DIARIO_USD="3"                # corta la ejecución si se supera

# ---------- Publicación ----------
REVISION_HUMANA="true"   # true = publica vía pull request; false = commit directo a main
ARTICULOS_MIN_DIA="3"
ARTICULOS_MAX_DIA="6"

# ---------- Publicidad (AdSense) ----------
ADSENSE_ACTIVO="false"            # mientras sea false no se carga ningún script
ADSENSE_CLIENT_ID=""              # ej. pub-XXXXXXXXXXXXXXXX
# CMP / consentimiento (obligatorio en la UE para servir anuncios)
CMP_ACTIVO="false"
CMP_PROVEEDOR="google"            # "google" (Privacidad y mensajes) u otro CMP TCF v2.2

# ---------- Analítica (siempre tras consentimiento) ----------
GA4_ID=""                         # ej. G-XXXXXXXXXX (vacío = desactivado)

# ---------- Métricas del panel (opcionales) ----------
# Cuenta de servicio de Google (GA4 Data API + Search Console API)
GOOGLE_SERVICE_ACCOUNT_JSON=""    # contenido JSON de la cuenta de servicio (una línea)
GA4_PROPERTY_ID=""                # ej. 123456789
SEARCH_CONSOLE_SITE_URL=""        # ej. https://bolsillodiario.es/
# AdSense Management API (OAuth con refresh token)
ADSENSE_OAUTH_CLIENT_ID=""
ADSENSE_OAUTH_CLIENT_SECRET=""
ADSENSE_REFRESH_TOKEN=""
ADSENSE_ACCOUNT_ID=""             # ej. pub-XXXXXXXXXXXXXXXX

# ---------- Alertas del panel (opcionales) ----------
ALERTAS_EMAIL=""                  # email para recibir alertas
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ---------- Fotos de artículos (opcional, Pexels) ----------
# Fotos con licencia de uso comercial. Sin clave, se usan portadas de color propias.
# Consigue una clave gratis en https://www.pexels.com/api/
PEXELS_API_KEY=""

# ---------- Newsletter (opcional, placeholder) ----------
NEWSLETTER_ACTION_URL=""          # URL del formulario de tu proveedor (Mailchimp, etc.)
