{
  "name": "bolsillo-diario",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Medio digital automatizado con agentes de IA sobre economía doméstica en España.",
  "workspaces": [
    "panel"
  ],
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "redaccion": "tsx agentes/orquestador.ts",
    "metricas": "tsx agentes/metricas/recolector.ts",
    "panel": "node scripts/panel.mjs",
    "panel:build": "npm --prefix panel run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts,.astro",
    "format": "prettier --write \"**/*.{ts,astro,md,json,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,astro,md,json,yaml,yml}\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@astrojs/mdx": "^4.0.8",
    "@astrojs/rss": "^4.0.11",
    "astro": "^5.6.1",
    "google-auth-library": "^9.15.0",
    "googleapis": "^144.0.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.6",
    "eslint": "^9.18.0",
    "eslint-plugin-astro": "^1.3.1",
    "prettier": "^3.4.2",
    "prettier-plugin-astro": "^0.14.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
