---
/**
 * Carruseles listos para Instagram y TikTok (los genera scripts/carruseles.ts).
 * Página de trabajo: no se indexa ni aparece en el menú.
 */
import { existsSync, readdirSync, readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';

interface Carrusel {
  slug: string;
  titulo: string;
  fecha: string;
  imagenes: number;
  texto: string;
  textoLinkedIn: string;
  enlaceLinkedIn: string;
  pdf: boolean;
}

const dir = resolve(process.cwd(), 'public/redes');
const carruseles: Carrusel[] = existsSync(dir)
  ? readdirSync(dir)
      .filter((d) => existsSync(resolve(dir, d, 'info.json')))
      .map((d) => ({
        enlaceLinkedIn: '',
        ...(JSON.parse(readFileSync(resolve(dir, d, 'info.json'), 'utf8')) as Omit<Carrusel, 'texto' | 'textoLinkedIn' | 'pdf'>),
        texto: readFileSync(resolve(dir, d, 'texto.txt'), 'utf8'),
        textoLinkedIn: existsSync(resolve(dir, d, 'linkedin.txt')) ? readFileSync(resolve(dir, d, 'linkedin.txt'), 'utf8') : '',
        pdf: existsSync(resolve(dir, d, 'linkedin.pdf')),
      }))
      .sort((a, b) => b.fecha.localeCompare(a.fecha))
  : [];
const formatoFecha = (f: string) => f.split('-').reverse().join('/');
---

<BaseLayout titulo="Carruseles para redes" noindex>
  <section class="redes">
    <h1>Carruseles para redes</h1>
    <p class="entradilla">
      Uno por noticia, listos para Instagram, TikTok (modo foto) y LinkedIn. Pulsa «Guardar imágenes» desde el
      móvil, copia el texto y publícalo. Para LinkedIn, descarga el PDF y súbelo como «documento».
    </p>
    <p><a class="ir-campana" href="/redes/campana/">📣 Ver el plan de campaña con todos los textos listos →</a></p>

    {carruseles.length === 0 && <p>Todavía no hay carruseles generados.</p>}

    {
      carruseles.map((c) => (
        <article class="carrusel" data-slug={c.slug} data-n={c.imagenes}>
          <p class="fecha">{formatoFecha(c.fecha)}</p>
          <h2>{c.titulo}</h2>
          <div class="tira">
            {Array.from({ length: c.imagenes }, (_, i) => (
              <a href={`/redes/${c.slug}/${i + 1}.jpg`} download={`${c.slug}-${i + 1}.jpg`}>
                <img src={`/redes/${c.slug}/${i + 1}.jpg`} alt={`Imagen ${i + 1} de ${c.imagenes}`} width="216" height="270" loading="lazy" />
              </a>
            ))}
          </div>
          <h3>Instagram y TikTok</h3>
          <div class="acciones">
            <button type="button" class="guardar">Guardar imágenes</button>
            <button type="button" class="copiar" data-copiar={`#ig-${c.slug}`}>Copiar texto</button>
          </div>
          <textarea id={`ig-${c.slug}`} readonly rows="6">{c.texto}</textarea>
          {c.pdf && (
            <>
              <h3>LinkedIn</h3>
              <div class="acciones">
                <a class="boton" href={`/redes/${c.slug}/linkedin.pdf`} download={`${c.slug}.pdf`}>Descargar PDF</a>
                <button type="button" class="copiar" data-copiar={`#li-${c.slug}`}>Copiar texto</button>
                <button type="button" class="copiar" data-texto={`Noticia completa 👉 ${c.enlaceLinkedIn}`}>Copiar 1.er comentario</button>
              </div>
              <textarea id={`li-${c.slug}`} readonly rows="6">{c.textoLinkedIn}</textarea>
            </>
          )}
        </article>
      ))
    }
  </section>
</BaseLayout>

<script>
  async function guardar(art: HTMLElement): Promise<void> {
    const slug = art.dataset.slug!;
    const n = Number(art.dataset.n);
    const urls = Array.from({ length: n }, (_, i) => `/redes/${slug}/${i + 1}.jpg`);
    const ficheros = await Promise.all(
      urls.map(async (u, i) => new File([await (await fetch(u)).blob()], `${slug}-${i + 1}.jpg`, { type: 'image/jpeg' })),
    );
    // En el móvil, la hoja de compartir permite «Guardar imágenes» o enviarlas directo a Instagram/TikTok.
    if (navigator.canShare?.({ files: ficheros })) {
      try {
        await navigator.share({ files: ficheros });
        return;
      } catch {
        return;
      }
    }
    for (const f of ficheros) {
      const a = document.createElement('a');
      a.href = URL.createObjectURL(f);
      a.download = f.name;
      a.click();
      await new Promise((r) => setTimeout(r, 300));
    }
  }

  document.querySelectorAll<HTMLElement>('.carrusel').forEach((art) => {
    art.querySelector('.guardar')?.addEventListener('click', () => void guardar(art));
  });
  // Botones «Copiar»: copian el texto de la caja indicada (data-copiar) o el de data-texto.
  document.querySelectorAll<HTMLButtonElement>('[data-copiar], [data-texto]').forEach((b) => {
    const original = b.textContent;
    b.addEventListener('click', async () => {
      const caja = b.dataset.copiar ? document.querySelector<HTMLTextAreaElement>(b.dataset.copiar) : null;
      const texto = caja?.value ?? b.dataset.texto ?? '';
      try {
        await navigator.clipboard.writeText(texto);
      } catch {
        caja?.select();
        document.execCommand('copy');
      }
      b.textContent = '¡Copiado!';
      setTimeout(() => (b.textContent = original), 2000);
    });
  });
</script>

<style>
  .redes {
    max-width: var(--ancho-lectura);
    margin-inline: auto;
  }
  .carrusel {
    border-top: 1px solid var(--color-borde);
    padding-block: 1.5rem;
  }
  .fecha {
    font-family: var(--fuente-ui);
    font-size: 0.85rem;
    color: var(--color-texto-suave);
    margin: 0;
  }
  .carrusel h2 {
    font-size: 1.25rem;
    margin: 0.25rem 0 0.75rem;
  }
  .tira {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 0.5rem;
  }
  .tira a {
    flex: 0 0 auto;
    scroll-snap-align: start;
  }
  .tira img {
    display: block;
    width: 216px;
    height: 270px;
    object-fit: cover;
    border: 1px solid var(--color-borde);
  }
  .acciones {
    display: flex;
    gap: 0.5rem;
    margin-block: 0.75rem;
  }
  .carrusel h3 {
    font-family: var(--fuente-ui);
    font-size: 0.95rem;
    margin: 1rem 0 0;
  }
  .ir-campana {
    font-family: var(--fuente-ui);
    font-weight: 700;
  }
  .acciones .boton,
  .acciones button {
    flex: 1;
    font-family: var(--fuente-ui);
    font-size: 1rem;
    font-weight: 600;
    padding: 0.75rem;
    border: 0;
    border-radius: 6px;
    cursor: pointer;
    background: var(--color-marca);
    color: #fff;
    text-align: center;
    text-decoration: none;
  }
  .acciones .copiar {
    background: var(--color-fondo-alt);
    color: var(--color-texto);
    border: 1px solid var(--color-borde-fuerte);
  }
  textarea {
    width: 100%;
    box-sizing: border-box;
    font-family: var(--fuente-ui);
    font-size: 0.9rem;
    background: var(--color-fondo-alt);
    color: var(--color-texto);
    border: 1px solid var(--color-borde);
    padding: 0.75rem;
  }
</style>
