---
import BaseLayout from '../layouts/BaseLayout.astro';
import Newsletter from '../components/Newsletter.astro';
import Anuncio from '../components/Anuncio.astro';
import { SITIO, categoriaPorSlug, colorCategoria } from '../lib/sitio';
import {
  todosLosArticulos,
  destacados,
  urlArticulo,
  categoriasConArticulos,
  minutosLectura,
  type Articulo,
} from '../lib/articulos';

const secciones = await categoriasConArticulos();
const arts = await todosLosArticulos();
const dest = await destacados(5);
const lead = dest[0] ?? arts[0];

// Orden: primero las destacadas (en su orden) y luego el resto por fecha, sin repetir.
const vistos = new Set<string>(lead ? [lead.id] : []);
const orden: Articulo[] = [];
for (const a of [...dest.slice(1), ...arts]) {
  if (vistos.has(a.id)) continue;
  vistos.add(a.id);
  orden.push(a);
}
const mosaico = orden.slice(0, 5); // 1 grande + 4 pequeñas, con foto
const mas = orden.slice(5, 14); // rejilla de tarjetas
const hoy = [lead, ...dest.slice(1)].filter(Boolean).slice(0, 4) as Articulo[];
const masLeidos = arts.slice(0, 5); // Se reordenará con datos reales de GA4 (ver panel).

const ahora = new Date();
const horaActualizacion = new Intl.DateTimeFormat('es-ES', {
  hour: '2-digit',
  minute: '2-digit',
  timeZone: 'Europe/Madrid',
}).format(ahora);

const cat = (a: Articulo) => categoriaPorSlug(a.data.categoria)?.nombre ?? '';
const color = (a: Articulo) => colorCategoria(a.data.categoria)[0];
---

<BaseLayout titulo={SITIO.nombre} descripcion={SITIO.descripcion}>
  {
    arts.length === 0 && (
      <p>
        Todavía no hay artículos publicados. Ejecuta el pipeline con{' '}
        <code>npm run redaccion -- --simulacion --sin-api</code> o espera a la primera edición.
      </p>
    )
  }

  {
    hoy.length > 0 && (
      <section class="hoy-tira" aria-label="Hoy en 1 minuto">
        <p class="hoy-tira-eti">
          <span class="pulso" aria-hidden="true" />
          Hoy en 1 minuto
          <span class="hoy-tira-hora">{horaActualizacion}</span>
        </p>
        <ol>
          {hoy.map((a, i) => (
            <li>
              <a href={urlArticulo(a)}>
                <span>0{i + 1}</span>
                {a.data.tituloSeo}
              </a>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  {
    lead && (
      <article class="portada-hero">
        <a href={urlArticulo(lead)} class="portada-hero-enlace">
          <img src={lead.data.imagen} alt={lead.data.imagenAlt} width="1600" height="900" />
          <div class="portada-hero-texto">
            <p class="sobre-foto-cat">
              <span style={`--cat:${color(lead)}`}>{cat(lead)}</span>
              {minutosLectura(lead)} min de lectura
            </p>
            <h1>{lead.data.titulo}</h1>
            {lead.data.porQueImporta && (
              <p class="portada-hero-importa">
                <strong>Por qué te importa.</strong> {lead.data.porQueImporta}
              </p>
            )}
            <span class="portada-hero-boton">
              Leer la noticia
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d="M4 10h11M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </div>
        </a>
      </article>
    )
  }

  {
    mosaico.length > 0 && (
      <section class="mosaico" aria-label="Destacadas">
        {mosaico.map((a, i) => (
          <article class={i === 0 ? 'losa losa-grande' : 'losa'}>
            <a href={urlArticulo(a)}>
              <img src={a.data.imagen} alt={a.data.imagenAlt} width="800" height="800" loading={i < 3 ? 'eager' : 'lazy'} />
              <div class="losa-texto">
                <p class="sobre-foto-cat">
                  <span style={`--cat:${color(a)}`}>{cat(a)}</span>
                  {minutosLectura(a)} min
                </p>
                <h2>{a.data.titulo}</h2>
              </div>
            </a>
          </article>
        ))}
      </section>
    )
  }

  <section class="franja" aria-label="Lo más leído y calculadoras">
    {
      masLeidos.length > 0 && (
        <div class="franja-leido">
          <h2 class="franja-titulo">Lo más leído</h2>
          <ol>
            {masLeidos.map((a, i) => (
              <li>
                <a href={urlArticulo(a)}>
                  <span class="franja-num">{i + 1}</span>
                  <img src={a.data.imagen} alt="" width="120" height="120" loading="lazy" />
                  <span class="franja-tit">{a.data.titulo}</span>
                </a>
              </li>
            ))}
          </ol>
        </div>
      )
    }
    <div class="franja-calc">
      <a href="/calculadoras/irpf/" class="calc-tarjeta">
        <span class="calc-tarjeta-eti">Gratis · 1 minuto</span>
        <span class="calc-tarjeta-tit">¿Cuánto te quita Hacienda?</span>
        <span class="calc-tarjeta-boton">Calcular mi IRPF</span>
      </a>
      <a href="/calculadoras/hipoteca/" class="calc-tarjeta calc-tarjeta-oscura">
        <span class="calc-tarjeta-eti">Euríbor al día</span>
        <span class="calc-tarjeta-tit">¿Y si sube tu hipoteca?</span>
        <span class="calc-tarjeta-boton">Calcular mi cuota</span>
      </a>
      <Anuncio formato="rectangulo" />
    </div>
  </section>

  {
    mas.length > 0 && (
      <section class="mas-noticias" aria-label="Más noticias">
        <div class="bloque-cabeza">
          <h2>Más noticias</h2>
          <span />
        </div>
        <div class="rejilla-fotos">
          {mas.slice(0, 6).map((a) => (
            <article class="foto-tarjeta">
              <a href={urlArticulo(a)} class="foto-tarjeta-img" tabindex="-1" aria-hidden="true">
                <img src={a.data.imagen} alt="" width="600" height="400" loading="lazy" />
              </a>
              <p class="dato-cat" style={`--cat:${color(a)}`}>
                {cat(a)}
                <span>· {minutosLectura(a)} min</span>
              </p>
              <h3>
                <a href={urlArticulo(a)}>{a.data.titulo}</a>
              </h3>
              <p class="foto-tarjeta-resumen">{a.data.descripcion}</p>
            </article>
          ))}
        </div>
        {mas.length > 6 && <Anuncio formato="horizontal" />}
        {mas.length > 6 && (
          <div class="rejilla-fotos">
            {mas.slice(6).map((a) => (
              <article class="foto-tarjeta">
                <a href={urlArticulo(a)} class="foto-tarjeta-img" tabindex="-1" aria-hidden="true">
                  <img src={a.data.imagen} alt="" width="600" height="400" loading="lazy" />
                </a>
                <p class="dato-cat" style={`--cat:${color(a)}`}>
                  {cat(a)}
                  <span>· {minutosLectura(a)} min</span>
                </p>
                <h3>
                  <a href={urlArticulo(a)}>{a.data.titulo}</a>
                </h3>
                <p class="foto-tarjeta-resumen">{a.data.descripcion}</p>
              </article>
            ))}
          </div>
        )}
      </section>
    )
  }

  <section class="explora" aria-label="Secciones">
    <div class="bloque-cabeza">
      <h2>Explora por secciones</h2>
      <span />
    </div>
    <div class="explora-lista">
      {
        secciones.map((c) => (
          <a href={`/categoria/${c.slug}/`} style={`--cat:${colorCategoria(c.slug)[0]}`}>
            <strong>{c.nombre}</strong>
            <span>{c.descripcion}</span>
          </a>
        ))
      }
    </div>
  </section>

  <Anuncio formato="horizontal" />

  <div style="margin-top:2.5rem;">
    <Newsletter />
  </div>
</BaseLayout>
