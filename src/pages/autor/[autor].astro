---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TarjetaArticulo from '../../components/TarjetaArticulo.astro';
import { SITIO, slugAutor } from '../../lib/sitio';
import { todosLosArticulos, articulosPorAutor } from '../../lib/articulos';

export async function getStaticPaths() {
  const arts = await todosLosArticulos();
  const autores = new Map<string, string>();
  // Solo se generan páginas de las firmas que realmente han publicado artículos.
  for (const a of arts) autores.set(slugAutor(a.data.autor), a.data.autor);
  return Array.from(autores.entries()).map(([slug, nombre]) => ({
    params: { autor: slug },
    props: { nombre },
  }));
}

const { autor } = Astro.params;
const { nombre } = Astro.props;
const arts = await articulosPorAutor(autor);

const bioEnv = (import.meta.env.AUTOR_BIO as string) ?? '';
const bio =
  bioEnv && bioEnv !== '[PENDIENTE]'
    ? bioEnv
    : SITIO.autorBio;

const persona = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: nombre,
  description: bio,
  url: new URL(`/autor/${autor}/`, SITIO.url).href,
  worksFor: { '@type': 'Organization', name: SITIO.nombre },
};
---

<BaseLayout titulo={nombre} descripcion={`Artículos de ${nombre} en ${SITIO.nombre}.`}>
  <Fragment slot="head">
    <set:html value={`<script type="application/ld+json">${JSON.stringify(persona)}</script>`} />
  </Fragment>

  <nav class="migas" aria-label="Ruta"><a href="/">Portada</a> › Autor</nav>
  <h1>{nombre}</h1>
  <p class="entradilla">{bio}</p>

  <h2>Artículos de {nombre}</h2>
  {
    arts.length === 0 ? (
      <p>Todavía no hay artículos publicados de este autor.</p>
    ) : (
      <div class="rejilla cols-3">
        {arts.map((a) => (
          <TarjetaArticulo articulo={a} />
        ))}
      </div>
    )
  }
</BaseLayout>
