---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Anuncio from '../../components/Anuncio.astro';
import { SECCIONES } from '../../lib/irpf-campos';
import { COMUNIDADES, DATOS_VACIOS, EJERCICIO } from '../../lib/irpf';
import { SITIO } from '../../lib/sitio';

const titulo = `Calculadora de IRPF ${EJERCICIO}: cuánto pagas a Hacienda y cuánto cobras neto`;
const descripcion =
  'La calculadora de IRPF más completa: sueldo, alquileres, autónomos, ahorro, hijos, planes de pensiones y deducciones por comunidad. Gratis, con gráficos y consejos para pagar menos.';
const valorInicial = (id: string) => (DATOS_VACIOS as unknown as Record<string, unknown>)[id];
const ICONOS: Record<string, string> = {
  personal: '👪',
  trabajo: '💼',
  ahorro: '🏦',
  inmuebles: '🏠',
  actividad: '🧾',
  ganancias: '📈',
  reducciones: '🐷',
  deducciones: '✂️',
};
// Anuncio intercalado tras estas secciones del formulario (sin cortar la lectura de una sección).
const ANUNCIO_TRAS = new Set(['trabajo', 'actividad']);
const esquema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: `Calculadora de IRPF ${EJERCICIO}`,
  url: `${SITIO.url}/calculadoras/irpf/`,
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Web',
  inLanguage: 'es-ES',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  publisher: { '@type': 'Organization', name: SITIO.nombre },
};
---

<BaseLayout titulo={titulo} descripcion={descripcion}>
  <script type="application/ld+json" set:html={JSON.stringify(esquema)} />
  <div class="calc">
    <nav class="migas" aria-label="Ruta"><a href="/calculadoras/">Calculadoras</a> › IRPF</nav>

    <header class="cabecera-calc">
      <h1>Calculadora de IRPF {EJERCICIO}</h1>
      <p class="entradilla">
        Mueve la barra o escribe tu sueldo y mira al instante cuánto te queda, cuánto se lleva Hacienda y si la renta
        te sale a pagar o a devolver. Después, afina con el resto de casillas: cada una explica qué poner.
      </p>

      <div class="rapido">
        <label for="deslizador" class="rapido-etq">Tu sueldo bruto anual</label>
        <div class="rapido-fila">
          <input id="deslizador" type="range" min="0" max="150000" step="500" value="0" aria-describedby="deslizador-valor" />
          <output id="deslizador-valor" class="rapido-valor">0 €</output>
        </div>
        <div class="chips" role="group" aria-label="Sueldos de ejemplo">
          {[17094, 22000, 30000, 45000, 70000].map((v) => (
            <button type="button" class="chip" data-sueldo={v}>{v.toLocaleString('es-ES')} €</button>
          ))}
        </div>
      </div>
    </header>

    <aside class="aviso" role="note">
      <strong>Aviso:</strong> simulación con fines exclusivamente informativos. No sustituye a la declaración oficial,
      a Renta Web ni al consejo de un asesor fiscal. Comprueba siempre tus datos en la
      <a href="https://sede.agenciatributaria.gob.es/" rel="noopener" target="_blank">Agencia Tributaria</a>.
    </aside>

    <Anuncio formato="horizontal" />

    <div class="calc-rejilla">
      <form id="form-irpf" class="formulario" autocomplete="off" onsubmit="return false">
        <ol class="pasos" aria-label="Secciones de la calculadora">
          {SECCIONES.map((s, i) => (
            <li><a href={`#sec-${s.id}`} data-paso={s.id}><span class="paso-num">{i + 1}</span><span class="paso-ico" aria-hidden="true">{ICONOS[s.id]}</span></a></li>
          ))}
        </ol>
        {
          SECCIONES.map((s) => (
            <>
              <details class="seccion" open={s.abierta} id={`sec-${s.id}`}>
                <summary>
                  <span class="seccion-ico" aria-hidden="true">{ICONOS[s.id]}</span>
                  <span class="seccion-texto">
                    <span class="seccion-titulo">{s.titulo.replace(/^\d+\.\s*/, '')}</span>
                    <span class="seccion-intro">{s.intro}</span>
                  </span>
                  <span class="seccion-cuenta" data-cuenta={s.id}></span>
                </summary>
                <div class="campos">
                  {s.campos.map((c) => (
                    <div class={`campo campo-${c.tipo}`} data-campo={c.id}>
                      {c.tipo === 'check' ? (
                        <label class="check">
                          <input type="checkbox" name={c.id} checked={Boolean(valorInicial(c.id))} />
                          <span class="interruptor" aria-hidden="true" />
                          <span>{c.etiqueta}</span>
                        </label>
                      ) : (
                        <label for={`c-${c.id}`}>{c.etiqueta}</label>
                      )}
                      {c.tipo === 'numero' && (
                        <div class="entrada">
                          <input
                            id={`c-${c.id}`}
                            name={c.id}
                            type="number"
                            inputmode="decimal"
                            step="any"
                            min={c.id === 'gananciasAhorro' ? undefined : 0}
                            placeholder={c.id === 'edad' ? '35' : '0'}
                            value={c.id === 'edad' ? '35' : ''}
                          />
                          {c.sufijo && <span class="sufijo">{c.sufijo}</span>}
                        </div>
                      )}
                      {c.tipo === 'select' && (
                        <select id={`c-${c.id}`} name={c.id}>
                          {c.opciones!.map(([v, t]) => (
                            <option value={v} selected={String(valorInicial(c.id)) === v}>
                              {t}
                            </option>
                          ))}
                        </select>
                      )}
                      <details class="info">
                        <summary>¿Qué pongo aquí?</summary>
                        <p>{c.info}</p>
                        {c.ejemplo && (
                          <p class="ejemplo">
                            <strong>Ejemplo:</strong> {c.ejemplo}
                          </p>
                        )}
                      </details>
                    </div>
                  ))}
                </div>
              </details>
              {ANUNCIO_TRAS.has(s.id) && <Anuncio formato="rectangulo" />}
            </>
          ))
        }
        <div class="acciones-form">
          <button type="button" id="btn-limpiar" class="boton-secundario">Borrar todo</button>
          <button type="button" id="btn-imprimir" class="boton-secundario">Imprimir o guardar en PDF</button>
        </div>
      </form>

      <div class="columna-resultado">
        <section class="resultado" id="resultado" aria-live="polite">
          <h2>Tu resultado</h2>
          <div class="neto">
            <span class="cifra-etq">Cobras neto al año</span>
            <span class="cifra-valor grande" id="r-neto" data-valor="0">0 €</span>
            <div class="mes">
              <div><strong id="r-neto-12">0 €</strong><span>al mes (12 pagas)</span></div>
              <div><strong id="r-neto-14">0 €</strong><span>al mes (14 pagas)</span></div>
            </div>
          </div>

          <figure class="donut-fig">
            <svg id="donut" viewBox="0 0 120 120" role="img" aria-labelledby="donut-titulo">
              <title id="donut-titulo">Reparto de tus ingresos brutos</title>
              <circle class="donut-fondo" cx="60" cy="60" r="46"></circle>
              <g id="donut-seg"></g>
              <text x="60" y="56" class="donut-pct" id="donut-pct">—</text>
              <text x="60" y="71" class="donut-sub">te queda</text>
            </svg>
            <figcaption>
              <ul class="leyenda" id="leyenda"></ul>
            </figcaption>
            <div class="tooltip" id="tooltip" hidden></div>
          </figure>

          <div class="tarjetas">
            <div class="tarjeta">
              <span class="cifra-etq">Pagas al Estado</span>
              <strong id="r-estado">0 €</strong>
              <span class="cifra-sub" id="r-estado-desglose"></span>
            </div>
            <div class="tarjeta" id="t-dif">
              <span class="cifra-etq" id="r-dif-etq">Tu declaración</span>
              <strong id="r-dif">0 €</strong>
              <span class="cifra-sub">tras lo ya retenido</span>
            </div>
          </div>

          <div class="medidores">
            <div class="medidor">
              <div class="medidor-cab"><span>Tipo medio de IRPF</span><strong id="r-medio">0 %</strong></div>
              <div class="barra"><span id="b-medio"></span></div>
            </div>
            <div class="medidor">
              <div class="medidor-cab"><span>Tipo marginal (por cada euro extra)</span><strong id="r-marginal">0 %</strong></div>
              <div class="barra"><span id="b-marginal"></span></div>
            </div>
          </div>
          <ul class="avisos" id="r-avisos"></ul>
          <p class="nota-empresa" id="r-empresa"></p>
        </section>
        <div class="solo-escritorio"><Anuncio formato="lateral" /></div>
      </div>
    </div>

    <a href="#resultado" class="barra-movil" id="barra-movil">
      <span>Neto: <strong id="b-neto">0 €</strong></span>
      <span id="b-dif">—</span>
      <span class="ver">Ver ↓</span>
    </a>

    <section class="bloque">
      <h2>Por qué tramos pasa tu sueldo</h2>
      <p class="bloque-intro">Cada barra es la parte de tu base liquidable general que paga ese tipo (estatal más autonómico). Pasa el dedo o el ratón por encima para ver el detalle.</p>
      <div class="tramos" id="tramos"></div>
    </section>

    <section class="bloque">
      <h2>¿Y si vivieras en otra comunidad?</h2>
      <p class="bloque-intro">El IRPF de tu mismo caso en cada comunidad de régimen común, de menos a más.</p>
      <div class="ranking" id="ranking"></div>
    </section>

    <Anuncio formato="horizontal" />

    <section class="bloque">
      <h2>Cómo podrías pagar menos (legalmente)</h2>
      <p class="bloque-intro">Consejos calculados con tus datos. No son una recomendación personalizada: valora tu situación o consulta a un asesor.</p>
      <ol class="consejos" id="r-consejos"></ol>
    </section>

    <section class="bloque">
      <details class="desplegable">
        <summary>Ver el desglose completo paso a paso (como en el modelo 100)</summary>
        <table class="desglose">
          <tbody id="r-desglose"></tbody>
        </table>
        <p class="fuente-escala" id="r-escala"></p>
      </details>
    </section>

    <section class="bloque explicacion">
      <h2>Cómo funciona el IRPF, en cinco pasos</h2>
      <ol>
        <li><strong>Sumas tus rentas</strong> por tipo: trabajo, alquileres, actividades, ahorro y ganancias. Cada una con sus gastos deducibles y reducciones.</li>
        <li><strong>Separas dos bases:</strong> la <em>general</em> (sueldo, alquileres, autónomos, premios) y la <em>del ahorro</em> (intereses, dividendos y ventas).</li>
        <li><strong>Restas las reducciones</strong> (planes de pensiones, tributación conjunta…) y obtienes la base liquidable.</li>
        <li><strong>Aplicas las escalas</strong> estatal y de tu comunidad. A la parte de renta que cubre tu mínimo personal y familiar no se le cobra impuesto.</li>
        <li><strong>Restas las deducciones</strong> y lo que ya te retuvieron: el resultado es lo que pagas o lo que te devuelven.</li>
      </ol>
      <p>
        La escala estatal va del 9,5 % al 24,5 % y se suma a la autonómica. La base del ahorro tributa al 19 % hasta
        6.000 €, 21 % hasta 50.000 €, 23 % hasta 200.000 €, 27 % hasta 300.000 € y 30 % a partir de ahí. Las escalas y
        mínimos autonómicos de esta calculadora están contrastados con el documento oficial <em>Tributación Autonómica.
        Medidas 2026</em> del Ministerio de Hacienda.
      </p>
      <details class="desplegable">
        <summary>Ver la escala autonómica de cada comunidad</summary>
        {
          COMUNIDADES.filter((c) => !c.foral && !c.ceutaMelilla).map((c) => (
            <div class="tabla-ccaa">
              <h4>{c.nombre}</h4>
              <p class="fuente-escala">{c.nota}</p>
              <table>
                <thead>
                  <tr><th>Base liquidable hasta</th><th>Tipo autonómico</th></tr>
                </thead>
                <tbody>
                  {c.escala.map(([hasta, tipo]) => (
                    <tr>
                      <td>{Number.isFinite(hasta) ? `${hasta.toLocaleString('es-ES')} €` : 'En adelante'}</td>
                      <td>{tipo.toLocaleString('es-ES')} %</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          ))
        }
      </details>
    </section>

    <aside class="aviso">
      <strong>Información meramente orientativa.</strong> {SITIO.nombre} no se hace responsable de las decisiones que se
      tomen a partir de esta simulación. Los datos que introduces no se envían a ningún servidor: el cálculo se hace en
      tu navegador.
    </aside>
  </div>
</BaseLayout>

<script>
  import {
    calcular,
    compararComunidades,
    consejos,
    tramosCombinados,
    DATOS_VACIOS,
    type Datos,
  } from '../../lib/irpf';
  import { SECCIONES } from '../../lib/irpf-campos';

  const form = document.getElementById('form-irpf') as HTMLFormElement;
  const CLAVE = 'bd-irpf-v1';
  const GRUPO = { useGrouping: 'always' } as Intl.NumberFormatOptions;
  const eur = (n: number) => `${Math.round(n).toLocaleString('es-ES', GRUPO)} €`;
  const eur2 = (n: number) =>
    `${n.toLocaleString('es-ES', { minimumFractionDigits: 2, maximumFractionDigits: 2, ...GRUPO })} €`;
  const pct = (n: number) => `${n.toLocaleString('es-ES', { maximumFractionDigits: 1 })} %`;
  const $ = (id: string) => document.getElementById(id)!;
  const salario = document.getElementById('c-salario') as HTMLInputElement;
  const deslizador = document.getElementById('deslizador') as HTMLInputElement;
  const tooltip = $('tooltip');
  const reducirMov = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /** Anima una cifra hasta su nuevo valor. */
  function animar(el: HTMLElement, destino: number): void {
    const origen = Number(el.dataset.valor ?? 0);
    el.dataset.valor = String(destino);
    if (reducirMov || origen === destino) {
      el.textContent = eur(destino);
      return;
    }
    const t0 = performance.now();
    const paso = (t: number) => {
      const k = Math.min(1, (t - t0) / 350);
      const e = 1 - Math.pow(1 - k, 3);
      el.textContent = eur(origen + (destino - origen) * e);
      if (k < 1 && el.dataset.valor === String(destino)) requestAnimationFrame(paso);
    };
    requestAnimationFrame(paso);
  }

  function leer(): Datos {
    const d = { ...DATOS_VACIOS } as Record<string, unknown>;
    for (const el of Array.from(form.elements) as (HTMLInputElement | HTMLSelectElement)[]) {
      if (!el.name || !(el.name in d)) continue;
      const actual = (DATOS_VACIOS as unknown as Record<string, unknown>)[el.name];
      if (el instanceof HTMLInputElement && el.type === 'checkbox') d[el.name] = el.checked;
      else if (typeof actual === 'number') {
        const v = parseFloat(String(el.value).replace(',', '.'));
        d[el.name] = Number.isFinite(v) ? v : el.name === 'edad' ? 35 : 0;
      } else d[el.name] = el.value;
    }
    return d as unknown as Datos;
  }

  function guardar(): void {
    try {
      const v: Record<string, string | boolean> = {};
      for (const el of Array.from(form.elements) as HTMLInputElement[]) {
        if (!el.name) continue;
        v[el.name] = el.type === 'checkbox' ? el.checked : el.value;
      }
      localStorage.setItem(CLAVE, JSON.stringify(v));
    } catch {
      /* sin almacenamiento: no pasa nada */
    }
  }

  function restaurar(): void {
    try {
      const v = JSON.parse(localStorage.getItem(CLAVE) ?? 'null') as Record<string, string | boolean> | null;
      if (!v) return;
      for (const el of Array.from(form.elements) as HTMLInputElement[]) {
        if (!el.name || !(el.name in v)) continue;
        if (el.type === 'checkbox') el.checked = Boolean(v[el.name]);
        else el.value = String(v[el.name]);
      }
    } catch {
      /* ignorar */
    }
  }

  function visibilidad(d: Datos): void {
    const ocultar = (id: string, oculto: boolean) =>
      document.querySelector<HTMLElement>(`[data-campo="${id}"]`)?.toggleAttribute('hidden', oculto);
    ocultar('ssManual', d.ssAutomatica);
    ocultar('actModulosRendimiento', d.actMetodo !== 'modulos');
    for (const id of ['actIngresos', 'actGastos']) ocultar(id, d.actMetodo === 'modulos');
    ocultar('asistencia', d.discapacidad === 'no');
    ocultar('conyugeDiscapacidad', d.tributacion !== 'conjunta');
  }

  /** Cuántas casillas ha rellenado el lector en cada sección. */
  function contarRellenos(d: Datos): void {
    for (const s of SECCIONES) {
      const n = s.campos.filter((c) => {
        const v = (d as unknown as Record<string, unknown>)[c.id];
        return c.tipo === 'numero' && c.id !== 'edad' && typeof v === 'number' && v !== 0;
      }).length;
      const el = document.querySelector<HTMLElement>(`[data-cuenta="${s.id}"]`);
      if (el) el.textContent = n ? `${n} ${n === 1 ? 'dato' : 'datos'}` : '';
      document.querySelector(`[data-paso="${s.id}"]`)?.classList.toggle('hecho', n > 0);
    }
  }

  function mostrarTooltip(e: PointerEvent | FocusEvent, html: string): void {
    tooltip.innerHTML = html;
    tooltip.hidden = false;
    const caja = (tooltip.parentElement as HTMLElement).getBoundingClientRect();
    const objetivo = (e.target as Element).getBoundingClientRect();
    const x = 'clientX' in e ? e.clientX : objetivo.left + objetivo.width / 2;
    const y = 'clientY' in e ? e.clientY : objetivo.top;
    tooltip.style.left = `${Math.min(Math.max(x - caja.left, 60), caja.width - 60)}px`;
    tooltip.style.top = `${y - caja.top - 12}px`;
  }

  function donut(partes: { nombre: string; valor: number; clase: string }[], total: number): void {
    const g = $('donut-seg');
    const R = 46;
    const C = 2 * Math.PI * R;
    const hueco = 1.2; // separación entre segmentos
    let acumulado = 0;
    const visibles = partes.filter((p) => p.valor > 0);
    g.innerHTML = visibles
      .map((p) => {
        const largo = Math.max(0, (p.valor / total) * C - (visibles.length > 1 ? hueco : 0));
        const seg = `<circle class="seg ${p.clase}" cx="60" cy="60" r="${R}" stroke-dasharray="${largo} ${C - largo}" stroke-dashoffset="${-acumulado}" transform="rotate(-90 60 60)" tabindex="0" data-nombre="${p.nombre}" data-valor="${p.valor}"></circle>`;
        acumulado += (p.valor / total) * C;
        return seg;
      })
      .join('');
    for (const s of Array.from(g.querySelectorAll<SVGCircleElement>('.seg'))) {
      const html = () => `<strong>${s.dataset.nombre}</strong><br>${eur(Number(s.dataset.valor))} · ${pct((Number(s.dataset.valor) / total) * 100)}`;
      s.addEventListener('pointermove', (e) => mostrarTooltip(e, html()));
      s.addEventListener('focus', (e) => mostrarTooltip(e, html()));
      s.addEventListener('pointerleave', () => (tooltip.hidden = true));
      s.addEventListener('blur', () => (tooltip.hidden = true));
    }
    $('leyenda').innerHTML = partes
      .filter((p) => p.valor > 0 || p.clase !== 'autonomos')
      .map(
        (p) =>
          `<li><span class="muestra ${p.clase}"></span><span class="ley-nombre">${p.nombre}</span><span class="ley-valor">${eur(p.valor)}<small>${total ? pct((p.valor / total) * 100) : '0 %'}</small></span></li>`,
      )
      .join('');
  }

  function pintarTramos(d: Datos, base: number, escalaAuto: Parameters<typeof tramosCombinados>[1]): void {
    const tramos = tramosCombinados(base, escalaAuto).filter((t) => t.base > 0);
    const maxBase = Math.max(1, ...tramos.map((t) => t.base));
    const maxTipo = Math.max(...tramos.map((t) => t.tipo), 1);
    $('tramos').innerHTML = tramos.length
      ? tramos
          .map((t) => {
            const intensidad = 0.35 + 0.65 * (t.tipo / Math.max(maxTipo, 50));
            const hasta = Number.isFinite(t.hasta) ? eur(t.hasta) : 'en adelante';
            return `<div class="tramo" tabindex="0" data-tip="De ${eur(t.desde)} a ${hasta}: ${eur(t.base)} al ${pct(t.tipo)} = ${eur(t.cuota)} (antes de restar el mínimo personal)">
              <span class="tramo-tipo">${pct(t.tipo)}</span>
              <span class="tramo-pista"><span class="tramo-barra" style="width:${(t.base / maxBase) * 100}%;opacity:${intensidad.toFixed(2)}"></span></span>
              <span class="tramo-importe">${eur(t.base)}</span>
            </div>`;
          })
          .join('')
      : '<p class="vacio">Introduce tus ingresos para ver tus tramos.</p>';
    for (const el of Array.from(document.querySelectorAll<HTMLElement>('#tramos .tramo'))) {
      el.title = el.dataset.tip ?? '';
    }
  }

  function pintarRanking(d: Datos, actual: string): void {
    if (d.salario + d.pensiones + d.actIngresos + d.alquilerIngresos + d.intereses + d.dividendos <= 0) {
      $('ranking').innerHTML = '<p class="vacio">Introduce tus ingresos para comparar.</p>';
      return;
    }
    const filas = compararComunidades(d);
    const max = Math.max(1, ...filas.map((f) => f.irpf));
    const mio = filas.find((f) => f.comunidad.slug === actual)?.irpf;
    $('ranking').innerHTML = filas
      .map((f) => {
        const dif = mio === undefined ? 0 : f.irpf - mio;
        const difTxt = f.comunidad.slug === actual ? 'tu comunidad' : `${dif > 0 ? '+' : dif < 0 ? '−' : ''}${eur(Math.abs(dif))}`;
        return `<div class="fila-rank ${f.comunidad.slug === actual ? 'actual' : ''}" title="${f.comunidad.nombre}: ${eur(f.irpf)} de IRPF">
          <span class="rank-nombre">${f.comunidad.nombre}</span>
          <span class="rank-pista"><span class="rank-barra" style="width:${(Math.max(0, f.irpf) / max) * 100}%"></span></span>
          <span class="rank-valor">${eur(f.irpf)}<small>${difTxt}</small></span>
        </div>`;
      })
      .join('');
  }

  function pintar(): void {
    const d = leer();
    visibilidad(d);
    contarRellenos(d);
    if (document.activeElement !== deslizador) deslizador.value = String(Math.min(d.salario, 150000));
    $('deslizador-valor').textContent = eur(d.salario);

    const r = calcular(d);
    animar($('r-neto'), r.netoAnual);
    $('r-neto-12').textContent = eur(r.netoAnual / 12);
    $('r-neto-14').textContent = eur(r.netoAnual / 14);
    $('r-estado').textContent = eur(r.totalEstado);
    const partes = [`IRPF ${eur(r.irpfTotal)}`, `S. Social ${eur(r.ssTrabajador)}`];
    if (r.cuotaAutonomos) partes.push(`autónomos ${eur(r.cuotaAutonomos)}`);
    $('r-estado-desglose').textContent = partes.join(' · ');
    const aPagar = r.cuotaDiferencial >= 0;
    $('r-dif-etq').textContent = aPagar ? 'Te sale a pagar' : 'Te devuelven';
    $('r-dif').textContent = eur(Math.abs(r.cuotaDiferencial));
    $('t-dif').className = `tarjeta ${aPagar ? 'pagar' : 'devolver'}`;
    $('r-medio').textContent = pct(r.tipoMedio);
    $('r-marginal').textContent = pct(r.tipoMarginal);
    ($('b-medio') as HTMLElement).style.width = `${Math.min(100, (r.tipoMedio / 55) * 100)}%`;
    ($('b-marginal') as HTMLElement).style.width = `${Math.min(100, (r.tipoMarginal / 55) * 100)}%`;
    $('b-neto').textContent = eur(r.netoAnual);
    $('b-dif').textContent = `${aPagar ? 'A pagar' : 'A devolver'}: ${eur(Math.abs(r.cuotaDiferencial))}`;
    $('r-empresa').textContent = r.ssEmpresaAprox
      ? `Además, tu empresa paga por ti a la Seguridad Social unos ${eur(r.ssEmpresaAprox)} al año (estimación del ~32 % sobre tu base de cotización), que no ves en la nómina.`
      : '';
    $('r-avisos').innerHTML = r.avisos.map((a) => `<li>${a}</li>`).join('');

    // Reparto del dinero bruto: lo que te queda y lo que se lleva cada parte.
    const irpfPos = Math.max(0, r.irpfTotal);
    const totalReparto = Math.max(0, r.netoAnual) + r.ssTrabajador + irpfPos + r.cuotaAutonomos;
    donut(
      [
        { nombre: 'Te queda', valor: Math.max(0, r.netoAnual), clase: 'neto' },
        { nombre: 'Seguridad Social', valor: r.ssTrabajador, clase: 'ss' },
        { nombre: 'IRPF', valor: irpfPos, clase: 'irpf' },
        { nombre: 'Cuota de autónomos', valor: r.cuotaAutonomos, clase: 'autonomos' },
      ],
      totalReparto || 1,
    );
    $('donut-pct').textContent = totalReparto ? pct((Math.max(0, r.netoAnual) / totalReparto) * 100) : '—';

    pintarTramos(d, r.baseLiquidableGeneral, r.comunidad.escala);
    pintarRanking(d, r.comunidad.slug);

    $('r-desglose').innerHTML = r.lineas
      .map((l) =>
        l.nivel === 0
          ? `<tr class="n0"><th colspan="2">${l.concepto}${l.importe ? ` <span>${eur2(l.importe)}</span>` : ''}</th></tr>`
          : `<tr class="n${l.nivel}"><td>${l.concepto}</td><td>${eur2(l.importe)}</td></tr>`,
      )
      .join('');
    $('r-escala').textContent = `Escala autonómica aplicada: ${r.comunidad.nombre}. ${r.comunidad.nota}`;

    $('r-consejos').innerHTML = consejos(d, r)
      .map(
        (c) =>
          `<li><div class="consejo-cab"><strong>${c.titulo}</strong>${c.ahorro ? `<span class="ahorro">ahorras ~${eur(c.ahorro)}</span>` : ''}</div><p>${c.texto}</p></li>`,
      )
      .join('');
    guardar();
  }

  restaurar();
  form.addEventListener('input', pintar);
  form.addEventListener('change', pintar);
  deslizador.addEventListener('input', () => {
    salario.value = deslizador.value === '0' ? '' : deslizador.value;
    pintar();
  });
  for (const b of Array.from(document.querySelectorAll<HTMLButtonElement>('.chip'))) {
    b.addEventListener('click', () => {
      salario.value = b.dataset.sueldo ?? '';
      pintar();
    });
  }
  $('btn-limpiar').addEventListener('click', () => {
    form.reset();
    try {
      localStorage.removeItem(CLAVE);
    } catch {
      /* ignorar */
    }
    pintar();
  });
  $('btn-imprimir').addEventListener('click', () => window.print());
  pintar();
</script>

