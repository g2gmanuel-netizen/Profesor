---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TarjetaArticulo from '../../components/TarjetaArticulo.astro';
import Anuncio from '../../components/Anuncio.astro';
import { categoriaPorSlug } from '../../lib/sitio';
import { articulosPorCategoria, categoriasConArticulos } from '../../lib/articulos';

export async function getStaticPaths() {
  // Solo se generan las secciones con artículos (las vacías no existen en la web).
  return (await categoriasConArticulos()).map((c) => ({ params: { categoria: c.slug } }));
}

const { categoria } = Astro.params;
const cat = categoriaPorSlug(categoria);
if (!cat) return Astro.redirect('/404');
const arts = await articulosPorCategoria(categoria);
// Bloques de 6 noticias con un anuncio entre bloque y bloque.
const bloques: (typeof arts)[] = [];
for (let i = 0; i < arts.length; i += 6) bloques.push(arts.slice(i, i + 6));
---

<BaseLayout titulo={cat.nombre} descripcion={cat.descripcion}>
  <nav class="migas" aria-label="Ruta"><a href="/">Portada</a> › {cat.nombre}</nav>
  <h1>{cat.nombre}</h1>
  <p class="entradilla">{cat.descripcion}</p>

  <Anuncio formato="horizontal" />

  {
    arts.length === 0 ? (
      <p>Todavía no hay artículos en esta sección.</p>
    ) : (
      bloques.map((bloque, i) => (
        <>
          {i > 0 && <Anuncio formato="horizontal" />}
          <div class="rejilla cols-3">
            {bloque.map((a) => (
              <TarjetaArticulo articulo={a} />
            ))}
          </div>
        </>
      ))
    )
  }

  {arts.length > 0 && <Anuncio formato="horizontal" />}
</BaseLayout>
