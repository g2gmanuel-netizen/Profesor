---
import { SITIO } from '../lib/sitio';
import { categoriasConArticulos, todosLosArticulos, urlArticulo } from '../lib/articulos';
const secciones = await categoriasConArticulos();
const rutaActual = Astro.url.pathname;
// Titulares para la barra de última hora: los 5 más recientes.
const ultimas = (await todosLosArticulos()).slice(0, 5);
---

<header class="cab">
  <div class="cab-directo" aria-label="Última hora">
    <div class="contenedor cab-directo-fila">
      <span class="cab-directo-etiqueta"><span class="pulso" aria-hidden="true"></span>Última hora</span>
      <div class="cab-cinta">
        <div class="cab-cinta-pista">
          {[...ultimas, ...ultimas].map((a, i) => (
            <a href={urlArticulo(a)} aria-hidden={i >= ultimas.length ? 'true' : undefined} tabindex={i >= ultimas.length ? -1 : undefined}>
              {a.data.tituloSeo}
            </a>
          ))}
        </div>
      </div>
      <span id="fecha-hoy" class="cab-fecha"></span>
    </div>
  </div>

  <div class="cab-principal">
    <div class="contenedor cab-principal-fila">
      <a href="/" class="cab-logo" aria-label={SITIO.nombre}>
        <svg class="logo-cerebro" viewBox="0 0 64 64" aria-hidden="true">
        <g transform="translate(32 33)" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M0 -17 a7 7 0 0 0 -13 2 a7 7 0 0 0 -6 9 a7.5 7.5 0 0 0 1.4 9.5 a7 7 0 0 0 2.6 8 a7 7 0 0 0 7 4 a6.5 6.5 0 0 0 8 1 Z"/>
          <path d="M0 -17 a7 7 0 0 1 13 2 a7 7 0 0 1 6 9 a7.5 7.5 0 0 1 -1.4 9.5 a7 7 0 0 1 -2.6 8 a7 7 0 0 1 -7 4 a6.5 6.5 0 0 1 -8 1 Z"/>
          <path d="M0 -17 V 16.5"/>
          <path d="M-13 -9 q4 1 5 4"/><path d="M13 -9 q-4 1 -5 4"/>
          <path d="M-18 2 q5 1 7 -2"/><path d="M18 2 q-5 1 -7 -2"/>
        </g>
      </svg>
        <span class="cab-logo-texto">
          <span class="cab-logo-nombre">Bolsillo <em>Diario</em></span>
          <span class="cab-logo-lema">Tu dinero y la actualidad, con cabeza</span>
        </span>
      </a>
      <div class="cab-acciones">
        <a href="/calculadoras/irpf/" class="cab-boton cab-boton-calc">
          <svg class="nav-boton-icono" viewBox="0 0 20 24" aria-hidden="true"><rect x="1.5" y="1.5" width="17" height="21" rx="3" fill="none" stroke="currentColor" stroke-width="2"/><rect x="5" y="5" width="10" height="4" rx="1" fill="currentColor"/><circle cx="6.5" cy="13.5" r="1.3" fill="currentColor"/><circle cx="10" cy="13.5" r="1.3" fill="currentColor"/><circle cx="13.5" cy="13.5" r="1.3" fill="currentColor"/><circle cx="6.5" cy="18" r="1.3" fill="currentColor"/><circle cx="10" cy="18" r="1.3" fill="currentColor"/><circle cx="13.5" cy="18" r="1.3" fill="currentColor"/></svg>
          <span class="cab-largo">Calculadora IRPF</span><span class="cab-corto">IRPF</span>
        </a>
        <a href="/calculadoras/hipoteca/" class="cab-boton cab-boton-calc">
          <svg class="nav-boton-icono" viewBox="0 0 20 24" aria-hidden="true"><rect x="1.5" y="1.5" width="17" height="21" rx="3" fill="none" stroke="currentColor" stroke-width="2"/><rect x="5" y="5" width="10" height="4" rx="1" fill="currentColor"/><circle cx="6.5" cy="13.5" r="1.3" fill="currentColor"/><circle cx="10" cy="13.5" r="1.3" fill="currentColor"/><circle cx="13.5" cy="13.5" r="1.3" fill="currentColor"/><circle cx="6.5" cy="18" r="1.3" fill="currentColor"/><circle cx="10" cy="18" r="1.3" fill="currentColor"/><circle cx="13.5" cy="18" r="1.3" fill="currentColor"/></svg>
          <span class="cab-largo">Calculadora hipoteca</span><span class="cab-corto">Hipoteca</span>
        </a>
        <a href="https://sportmaniac.app/" class="cab-boton cab-boton-juegos" target="_blank" rel="noopener" aria-label="Juegos (Sportmanía)">
          <svg class="nav-juegos-mando" viewBox="0 0 32 20" aria-hidden="true">
          <path d="M8 2h16a7 7 0 0 1 6.8 8.6l-1.4 5.6a3 3 0 0 1-5 1.4L20.6 14h-9.2l-3.8 3.6a3 3 0 0 1-5-1.4L1.2 10.6A7 7 0 0 1 8 2z" fill="currentColor"/>
          <path d="M9 6.5v5M6.5 9h5" stroke="#0f0f11" stroke-width="1.8" stroke-linecap="round"/>
          <circle cx="21.5" cy="7.5" r="1.4" fill="#e5322d"/>
          <circle cx="24.5" cy="10.5" r="1.4" fill="#e5322d"/>
        </svg>
          <span>Juegos</span>
        </a>
        <a href="/buscar/" class="cab-buscar" aria-label="Buscar">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2.2"/><path d="M15.5 15.5 21 21" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
        </a>
      </div>
    </div>
  </div>

  <nav class="cab-nav" aria-label="Secciones">
    <div class="contenedor cab-nav-fila">
      {secciones.map((c) => (
        <a href={`/categoria/${c.slug}/`} aria-current={rutaActual.startsWith(`/categoria/${c.slug}/`) ? 'page' : undefined}>
          {c.nombre}
        </a>
      ))}
    </div>
  </nav>
</header>

<script is:inline>
  (function () {
    var el = document.getElementById('fecha-hoy');
    if (el) {
      try {
        el.textContent = new Intl.DateTimeFormat('es-ES', {
          weekday: 'long',
          day: 'numeric',
          month: 'long',
          year: 'numeric',
        }).format(new Date());
      } catch (e) {}
    }
  })();
</script>
