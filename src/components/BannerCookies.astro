---
/**
 * Banner de cookies (la UI). Se renderiza en el <body> para que su posición fija
 * y sus estilos se apliquen bien. El Consent Mode por defecto lo fija
 * Consentimiento.astro desde el <head>.
 */
import { SITIO } from '../lib/sitio';
const cmpActivo = SITIO.cmp.activo;
---

{
  cmpActivo && (
    <div id="bd-cmp" class="cmp-banner" hidden role="dialog" aria-live="polite" aria-label="Aviso de cookies">
      <div class="cmp-texto">
        <strong class="cmp-titulo">🍪 Tu privacidad</strong>
        <p>
          Usamos cookies propias y de terceros para analítica y publicidad. ¿Nos das tu
          consentimiento? Puedes leer nuestra <a href="/politica-cookies/">política de cookies</a>.
        </p>
      </div>
      <div class="cmp-botones">
        <button type="button" data-consent="denied">Rechazar</button>
        <button type="button" data-consent="granted" class="primario">Aceptar</button>
      </div>
    </div>
  )
}

{cmpActivo && (
  <script is:inline>
    (function () {
      var banner = document.getElementById('bd-cmp');
      if (!banner) return;
      var guardado = null;
      try {
        guardado = localStorage.getItem('bd-consent');
      } catch (e) {}
      if (!guardado) banner.hidden = false;
      banner.querySelectorAll('button[data-consent]').forEach(function (b) {
        b.addEventListener('click', function () {
          var estado = b.getAttribute('data-consent');
          try {
            localStorage.setItem('bd-consent', estado);
          } catch (e) {}
          if (window.gtag) {
            window.gtag('consent', 'update', {
              ad_storage: estado,
              ad_user_data: estado,
              ad_personalization: estado,
              analytics_storage: estado,
            });
          }
          banner.hidden = true;
        });
      });
    })();
  </script>
)}

<style>
  .cmp-banner {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 100;
    background: var(--color-fondo);
    border-top: 4px solid var(--color-marca);
    padding: 1.25rem 1rem calc(1.25rem + env(safe-area-inset-bottom, 0px));
    font-family: var(--fuente-ui);
    font-size: 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    align-items: center;
    justify-content: center;
    box-shadow: 0 -8px 30px rgba(0, 0, 0, 0.28);
  }
  .cmp-banner[hidden] {
    display: none;
  }
  .cmp-texto {
    max-width: 56ch;
    flex: 1;
    min-width: min(100%, 280px);
  }
  .cmp-titulo {
    display: block;
    font-size: 1.1rem;
    color: var(--color-marca);
    margin-bottom: 0.2rem;
  }
  .cmp-banner p {
    margin: 0;
  }
  .cmp-botones {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .cmp-botones button {
    padding: 13px 28px;
    border-radius: 999px;
    border: 2px solid var(--color-marca);
    cursor: pointer;
    font-weight: 800;
    font-size: 1rem;
    background: var(--color-fondo);
    color: var(--color-marca);
    min-width: 130px;
  }
  .cmp-botones button:hover {
    filter: brightness(1.05);
  }
  .cmp-botones .primario {
    background: var(--color-marca);
    color: #fff;
  }
</style>
