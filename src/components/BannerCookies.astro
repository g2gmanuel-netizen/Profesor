---
/**
 * Banner de cookies (la UI). Se renderiza en el <body> para que su posición fija
 * y sus estilos se apliquen bien. El Consent Mode por defecto lo fija
 * Consentimiento.astro desde el <head>.
 */
import { SITIO } from '../lib/sitio';
const cmpActivo = SITIO.cmp.activo;
---

{
  cmpActivo && (
    <div id="bd-cmp" class="cmp-banner" hidden role="dialog" aria-modal="true" aria-labelledby="bd-cmp-titulo">
      <div class="cmp-tarjeta">
        <p class="cmp-marca">Bolsillo Diario</p>
        <p class="cmp-titulo" id="bd-cmp-titulo">Te damos la bienvenida</p>
        <p class="cmp-texto">
          Aquí explicamos la actualidad y el dinero de forma clara y gratuita. Para seguir haciéndolo,
          usamos cookies con nuestros socios para medir la audiencia y mostrar publicidad. Al
          aceptar, nos ayudas a mantener la web gratis para todos.
        </p>
        <div class="cmp-botones">
          <button type="button" data-consent="granted" class="primario">Aceptar y entrar</button>
          <button type="button" data-consent="denied">Rechazar</button>
        </div>
        <p class="cmp-pie">
          Puedes cambiar tu elección cuando quieras. Más información en la
          <a href="/politica-cookies/">política de cookies</a>.
        </p>
      </div>
    </div>
  )
}

{cmpActivo && (
  <script is:inline>
    (function () {
      var banner = document.getElementById('bd-cmp');
      if (!banner) return;
      var guardado = null;
      try {
        guardado = localStorage.getItem('bd-consent');
      } catch (e) {}
      if (!guardado) {
        banner.hidden = false;
        document.documentElement.classList.add('cmp-abierto');
      }
      banner.querySelectorAll('button[data-consent]').forEach(function (b) {
        b.addEventListener('click', function () {
          var estado = b.getAttribute('data-consent');
          try {
            localStorage.setItem('bd-consent', estado);
          } catch (e) {}
          if (window.gtag) {
            window.gtag('consent', 'update', {
              ad_storage: estado,
              ad_user_data: estado,
              ad_personalization: estado,
              analytics_storage: estado,
            });
          }
          banner.hidden = true;
          document.documentElement.classList.remove('cmp-abierto');
        });
      });
    })();
  </script>
)}

<style>
  .cmp-banner {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    background: rgba(10, 20, 15, 0.55);
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
    font-family: var(--fuente-ui);
  }
  .cmp-banner[hidden] {
    display: none;
  }
  :global(html.cmp-abierto) {
    overflow: hidden;
  }
  .cmp-tarjeta {
    width: 100%;
    max-width: 460px;
    max-height: calc(100vh - 2rem);
    overflow-y: auto;
    background: var(--color-fondo);
    border-top: 5px solid var(--color-marca);
    border-radius: 16px;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.35);
    padding: 1.75rem 1.75rem 1.4rem;
    text-align: center;
  }
  .cmp-marca {
    font-family: var(--fuente-display);
    font-weight: 900;
    font-size: 1.6rem;
    margin: 0;
    line-height: 1.1;
  }
  .cmp-titulo {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-marca);
    margin: 0.4rem 0 0.9rem;
  }
  .cmp-texto {
    margin: 0 0 1.3rem;
    font-size: 0.98rem;
    line-height: 1.55;
  }
  .cmp-botones {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .cmp-botones button {
    width: 100%;
    padding: 14px 24px;
    border-radius: 999px;
    border: 2px solid var(--color-marca);
    cursor: pointer;
    font-weight: 800;
    font-size: 1.02rem;
    background: var(--color-fondo);
    color: var(--color-marca);
  }
  .cmp-botones button:hover {
    filter: brightness(1.05);
  }
  .cmp-botones .primario {
    background: var(--color-marca);
    color: #fff;
  }
  .cmp-pie {
    margin: 1rem 0 0;
    font-size: 0.82rem;
    opacity: 0.8;
  }
  .cmp-pie a {
    color: var(--color-marca);
    font-weight: 600;
  }
</style>
