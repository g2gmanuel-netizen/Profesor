---
/**
 * Banner de cookies (la UI). Se renderiza en el <body> para que su posición fija
 * y sus estilos se apliquen bien. El Consent Mode por defecto lo fija
 * Consentimiento.astro desde el <head>.
 */
import { SITIO } from '../lib/sitio';
const cmpActivo = SITIO.cmp.activo;
---

{
  cmpActivo && (
    <div id="bd-cmp" class="cmp-banner" hidden role="dialog" aria-live="polite" aria-labelledby="bd-cmp-titulo">
      <div class="cmp-tarjeta">
        <div class="cmp-texto">
          <p class="cmp-titulo" id="bd-cmp-titulo">Bolsillo Diario es gratis gracias a ti</p>
          <p>
            Para seguir sin muros de pago usamos cookies que nos dicen qué noticias te interesan y
            nos permiten mostrar publicidad. Si aceptas, nos ayudas a seguir siendo gratis. Puedes
            cambiar de opinión cuando quieras en la <a href="/politica-cookies/">política de cookies</a>.
          </p>
        </div>
        <div class="cmp-botones">
          <button type="button" data-consent="granted" class="primario">Aceptar y continuar</button>
          <button type="button" data-consent="denied">Rechazar</button>
        </div>
      </div>
    </div>
  )
}

{cmpActivo && (
  <script is:inline>
    (function () {
      var banner = document.getElementById('bd-cmp');
      if (!banner) return;
      var guardado = null;
      try {
        guardado = localStorage.getItem('bd-consent');
      } catch (e) {}
      if (!guardado) banner.hidden = false;
      banner.querySelectorAll('button[data-consent]').forEach(function (b) {
        b.addEventListener('click', function () {
          var estado = b.getAttribute('data-consent');
          try {
            localStorage.setItem('bd-consent', estado);
          } catch (e) {}
          if (window.gtag) {
            window.gtag('consent', 'update', {
              ad_storage: estado,
              ad_user_data: estado,
              ad_personalization: estado,
              analytics_storage: estado,
            });
          }
          banner.hidden = true;
        });
      });
    })();
  </script>
)}

<style>
  .cmp-banner {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 100;
    padding: 0 0.75rem calc(0.75rem + env(safe-area-inset-bottom, 0px));
    font-family: var(--fuente-ui);
    display: flex;
    justify-content: center;
    pointer-events: none;
  }
  .cmp-banner[hidden] {
    display: none;
  }
  .cmp-tarjeta {
    pointer-events: auto;
    width: 100%;
    max-width: 880px;
    background: var(--color-fondo);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-top: 4px solid var(--color-marca);
    border-radius: 14px;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.3);
    padding: 1.25rem 1.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    align-items: center;
  }
  .cmp-texto {
    flex: 1 1 420px;
    min-width: 0;
  }
  .cmp-titulo {
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--color-marca);
    margin: 0 0 0.35rem;
  }
  .cmp-texto p {
    margin: 0;
    font-size: 0.97rem;
    line-height: 1.5;
  }
  .cmp-texto a {
    color: var(--color-marca);
    font-weight: 600;
  }
  .cmp-botones {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    flex: 0 0 auto;
  }
  .cmp-botones button {
    padding: 13px 28px;
    border-radius: 999px;
    border: 2px solid var(--color-marca);
    cursor: pointer;
    font-weight: 800;
    font-size: 1rem;
    background: var(--color-fondo);
    color: var(--color-marca);
    min-width: 220px;
  }
  .cmp-botones button:hover {
    filter: brightness(1.05);
  }
  .cmp-botones .primario {
    background: var(--color-marca);
    color: #fff;
  }
  @media (max-width: 600px) {
    .cmp-tarjeta {
      padding: 1rem 1.1rem;
    }
    .cmp-botones {
      width: 100%;
    }
    .cmp-botones button {
      width: 100%;
      min-width: 0;
    }
  }
</style>
