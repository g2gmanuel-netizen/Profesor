---
/**
 * Gestor de consentimiento (CMP) + Google Consent Mode v2.
 * - Por defecto todo DENEGADO hasta que la persona acepte.
 * - Si CMP_ACTIVO=false, no se carga nada (desarrollo / pre-AdSense).
 * - En producción con AdSense, Google exige un CMP certificado TCF v2.2.
 *   Aquí dejamos un banner propio mínimo que fija el Consent Mode; para la UE
 *   debe sustituirse/activarse el CMP de Google "Privacidad y mensajes"
 *   (ver GUIA_PASOS_MANUALES.md, paso de AdSense).
 */
import { SITIO } from '../lib/sitio';
const cmpActivo = SITIO.cmp.activo;
---

{/* Consent Mode v2: denegado por defecto, SIEMPRE que haya analítica o anuncios */}
{
  (cmpActivo || SITIO.ga4Id || SITIO.adsense.activo) && (
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      window.gtag = window.gtag || gtag;
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        wait_for_update: 500,
      });
      // Si ya aceptó en una visita anterior, restaurar.
      try {
        if (localStorage.getItem('bd-consent') === 'granted') {
          gtag('consent', 'update', {
            ad_storage: 'granted',
            ad_user_data: 'granted',
            ad_personalization: 'granted',
            analytics_storage: 'granted',
          });
        }
      } catch (e) {}
    </script>
  )
}

{
  cmpActivo && (
    <div id="bd-cmp" class="cmp-banner" hidden role="dialog" aria-live="polite" aria-label="Aviso de cookies">
      <div class="cmp-texto">
        <strong class="cmp-titulo">🍪 Tu privacidad</strong>
        <p>
          Usamos cookies propias y de terceros para analítica y publicidad. ¿Nos das tu
          consentimiento? Puedes leer nuestra <a href="/politica-cookies/">política de cookies</a>.
        </p>
      </div>
      <div class="cmp-botones">
        <button type="button" data-consent="denied">Rechazar</button>
        <button type="button" data-consent="granted" class="primario">Aceptar</button>
      </div>
    </div>
  )
}

{
  cmpActivo && (
    <>
      <style>
        {`
        .cmp-banner{position:fixed;inset-inline:0;bottom:0;z-index:100;background:var(--color-fondo);
          border-top:4px solid var(--color-marca);padding:1.25rem 1rem calc(1.25rem + env(safe-area-inset-bottom,0px));
          font-family:var(--fuente-ui);font-size:1rem;display:flex;flex-wrap:wrap;gap:1rem 1.5rem;
          align-items:center;justify-content:center;box-shadow:0 -8px 30px rgba(0,0,0,.28)}
        .cmp-texto{max-width:56ch;flex:1;min-width:min(100%,280px)}
        .cmp-titulo{display:block;font-size:1.1rem;color:var(--color-marca);margin-bottom:.2rem}
        .cmp-banner p{margin:0}
        .cmp-botones{display:flex;gap:.75rem;flex-wrap:wrap}
        .cmp-botones button{padding:13px 28px;border-radius:999px;border:2px solid var(--color-marca);
          cursor:pointer;font-weight:800;font-size:1rem;background:var(--color-fondo);color:var(--color-marca);
          min-width:130px}
        .cmp-botones button:hover{filter:brightness(1.05)}
        .cmp-botones .primario{background:var(--color-marca);color:#fff}
        @media (min-width:720px){.cmp-banner{font-size:1.05rem}}
      `}
      </style>
      <script is:inline>
        (function () {
          var banner = document.getElementById('bd-cmp');
          if (!banner) return;
          var guardado = null;
          try {
            guardado = localStorage.getItem('bd-consent');
          } catch (e) {}
          if (!guardado) banner.hidden = false;
          banner.querySelectorAll('button[data-consent]').forEach(function (b) {
            b.addEventListener('click', function () {
              var estado = b.getAttribute('data-consent');
              try {
                localStorage.setItem('bd-consent', estado);
              } catch (e) {}
              if (window.gtag) {
                window.gtag('consent', 'update', {
                  ad_storage: estado,
                  ad_user_data: estado,
                  ad_personalization: estado,
                  analytics_storage: estado,
                });
              }
              banner.hidden = true;
              if (estado === 'granted') document.dispatchEvent(new Event('bd-consent-granted'));
            });
          });
        })();
      </script>
    </>
  )
}
