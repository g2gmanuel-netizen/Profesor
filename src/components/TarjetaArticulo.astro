---
import { categoriaPorSlug, colorCategoria } from '../lib/sitio';
import { fechaLegible, urlArticulo, minutosLectura, type Articulo } from '../lib/articulos';

interface Props {
  articulo: Articulo;
}
const { articulo } = Astro.props;
const cat = categoriaPorSlug(articulo.data.categoria);
const color = colorCategoria(articulo.data.categoria)[0];
---

<article class="tarjeta">
  <a href={urlArticulo(articulo)} aria-label={articulo.data.titulo} class="tarjeta-foto">
    <img
      src={articulo.data.imagen}
      alt={articulo.data.imagenAlt}
      width="1200"
      height="675"
      loading="lazy"
    />
  </a>
  <div class="tarjeta-cuerpo">
    {
      cat && (
        <p class="dato-cat" style={`--cat:${color}`}>
          {cat.nombre}
          <span>· {minutosLectura(articulo)} min</span>
        </p>
      )
    }
    <h3>
      <a href={urlArticulo(articulo)}>{articulo.data.titulo}</a>
    </h3>
    <p class="meta">
      {articulo.data.autor} · <time datetime={articulo.data.fechaPublicacion.toISOString()}>
        {fechaLegible(articulo.data.fechaPublicacion)}
      </time>
    </p>
  </div>
</article>
